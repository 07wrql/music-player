; *************************************************************
; *** BootLoader Scatter File (参照参考项目)
; *** 地址: 0x08000000, 大小: 64KB
; *** 使用 *.o (RESET, +First) — 工程里只保留一个启动文件即可
; *************************************************************

LR_IROM1 0x08000000 0x00010000  {
  ER_IROM1 0x08000000 0x00010000  {
   *.o (RESET, +First)
   *(InRoot$$Sections)
   .ANY (+RO)
  }
  RW_IRAM1 0x20000000 0x0001C000  {
   .ANY (+RW +ZI)
  }
}
